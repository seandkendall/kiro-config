# Misc
argv.json
agents/agent_config.json.example

# Kiro Crew (kirodotdev/KiroCrew) — separate first-party product, manages its own
# agents/config in this shared ~/.kiro directory. Not part of this repo.
agents/kirocrew*.json
agents/kirocrew*.json.bak
agents/kirocrew*.json.bak.*
agents/kirocrew.lock
prompts/kirocrew*.md
crew/
settings/survey_state.json
settings/feed_state.json

# Amazon Builder internal tooling — writes its own agents into this shared
# ~/.kiro directory and its own internal-only steering docs. Not part of this
# public repo; must never be committed (internal Amazon systems/tooling).
agents/AmazonBuilderCoreAIAgents-*.json
steering/amazon-builder/

# AIM (Amazon internal) core-skills provisioning — installs its own skill
# bundles into this shared ~/.kiro/skills directory, marked with a
# .aim-managed file in each skill dir. Not part of this public repo.
skills/.aim-core-skills.json
skills/.aim-staging/
skills/agent-sop-author/
skills/brazil/
skills/brazil-build-analyzer-skill/
skills/builder-insights/
skills/builderhub-create/
skills/crux-code-reviews/
skills/deployment-fixer/
skills/fix-integration-test/
skills/golden-path-recommendations/
skills/improve-integration-test-coverage/
skills/tell-asbx-that/
skills/tst/
skills/wiki-edit/

# Kiro CLI runtime session state — not part of this repo's config
session-index/

# Personal agents (local-only, never shared)
agents/accounting.json
agents/personal-*.json
agents/accounting.md
agents/personal-*.md
agents/v2-backup/accounting.json
agents/v2-backup/personal-*.json
prompts/accounting.md
prompts/personal-*.md

# Externally-managed ACP agent configs (machine-specific, auto-generated — e.g. QuickWork)
agents/*_acp_*.json

# Personal steering rules (self-evolving, user-specific, never shared)
steering/personal-*.md
# Exception: the protocol file itself lives in the public repo
!steering/personal-rules-protocol.md

# Editor / manual backup files (never commit)
*.bak
*.backup
* copy.*

# CLI runtime / machine-specific state (never commit)
logs/
workspace-roots/
.trust-migration.json

# Kiro CLI cross-session memory store (memories.db, SQLite) — machine-specific
# runtime state holding personal working-style preferences and durable facts
# pulled from real sessions (per the `memory` tool's own USER_PREFERENCE/SEMANTIC
# schema). Same storage pattern and locality as sessions/logs/workspace-roots
# above; no official kiro.dev guidance found either way as of this writing, but
# it is user-specific, potentially sensitive, and a binary SQLite file (bad for
# git regardless) — never commit.
memories/

# Kiro CLI global MCP config (settings/mcp.json + settings/mcp.lock) — this
# repo's convention is self-contained per-agent mcpServers blocks (see May
# 2026 commit "Remove stray global settings/mcp.json - agents are
# self-contained"). Kiro CLI/Kiro Crew silently re-write this file with
# machine-local servers (creds-agent, playwright-mcp) between sessions, and
# the user may deliberately add their own machine-local global entries (e.g.
# google-drive) on top — either way this is local-only state, never commit.
settings/mcp.json
settings/mcp.lock

# Kiro CLI V3 capability-permissions file (keep gitignored — permanently).
# Per the V3 docs, user-scope (~/.kiro/settings/permissions.yaml) and workspace-scope
# (~/.kiro/workspace-roots/<hash>/permissions.yaml) rules are machine-local, per-user, and
# live OUTSIDE the repo by design — "a cloned repo cannot inject permission rules."
# Repo-shareable permissions belong in each agent profile's `permissions:` block (V3 Markdown
# agents), NOT here. See steering/kiro-cli-v3-migration.md.
settings/permissions.yaml

# Pre-V3-migration backup (machine-local, never commit)
agents/v2-backup/

# Kiro CLI embedding-model cache (auto-downloaded, 86+ MB — never commit)
models/
