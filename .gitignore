# Sessions and history
sessions/
.cli_bash_history

# IDE extensions
extensions/

# Powers (user-specific installs)
powers/

# MCP servers (local builds)
mcp-servers/

# Credentials and secrets
elevenlabskey.txt
*.secret
.env
.env.local
gcp-oauth.keys.json
**/gcp-oauth.keys.json

# macOS
.DS_Store

# Backups
steering-backup-*/

# Misc
argv.json
agents/agent_config.json.example
settings/survey_state.json
settings/feed_state.json

# Personal agents (local-only, never shared)
agents/accounting.json
agents/personal-*.json
agents/accounting.md
agents/personal-*.md
agents/v2-backup/accounting.json
agents/v2-backup/personal-*.json
prompts/accounting.md
prompts/personal-*.md

# Externally-managed ACP agent configs (machine-specific, auto-generated — e.g. QuickWork)
agents/*_acp_*.json

# Personal steering rules (self-evolving, user-specific, never shared)
steering/personal-*.md
# Exception: the protocol file itself lives in the public repo
!steering/personal-rules-protocol.md

# Editor / manual backup files (never commit)
*.bak
*.backup
* copy.*

# CLI runtime / machine-specific state (never commit)
logs/
workspace-roots/
.trust-migration.json

# Kiro CLI V3 capability-permissions file (keep gitignored — permanently).
# Per the V3 docs, user-scope (~/.kiro/settings/permissions.yaml) and workspace-scope
# (~/.kiro/workspace-roots/<hash>/permissions.yaml) rules are machine-local, per-user, and
# live OUTSIDE the repo by design — "a cloned repo cannot inject permission rules."
# Repo-shareable permissions belong in each agent profile's `permissions:` block (V3 Markdown
# agents), NOT here. See steering/kiro-cli-v3-migration.md.
settings/permissions.yaml

# Pre-V3-migration backup (machine-local, never commit)
agents/v2-backup/
