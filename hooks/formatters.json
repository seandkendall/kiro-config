{
  "version": "v1",
  "hooks": [
    {
      "name": "ruff-on-save",
      "description": "Auto-fix + format Python files on save",
      "trigger": "PostFileSave",
      "matcher": "\\.py$",
      "action": {
        "type": "command",
        "command": "ruff check --fix --quiet \"{{filePath}}\" 2>/dev/null; ruff format --quiet \"{{filePath}}\" 2>/dev/null || true"
      },
      "timeout": 30
    },
    {
      "name": "prettier-on-save",
      "description": "Format JS/TS/CSS/HTML/JSON/MD/YAML on save",
      "trigger": "PostFileSave",
      "matcher": "\\.(js|jsx|ts|tsx|css|scss|html|json|md|ya?ml)$",
      "action": {
        "type": "command",
        "command": "npx prettier --write \"{{filePath}}\" 2>/dev/null || true"
      },
      "timeout": 60
    },
    {
      "name": "shfmt-on-save",
      "description": "Format shell scripts on save",
      "trigger": "PostFileSave",
      "matcher": "\\.sh$",
      "action": {
        "type": "command",
        "command": "shfmt -w \"{{filePath}}\" 2>/dev/null || true"
      },
      "timeout": 30
    },
    {
      "name": "swiftformat-on-save",
      "description": "Format Swift files on save",
      "trigger": "PostFileSave",
      "matcher": "\\.swift$",
      "action": {
        "type": "command",
        "command": "swiftformat --quiet \"{{filePath}}\" 2>/dev/null || true"
      },
      "timeout": 30
    }
  ]
}
