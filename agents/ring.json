{
  "name": "ring",
  "description": "Amazon Ring integration agent — build apps/integrations for the Ring App Store and Ring devices (cameras, doorbells, alarm) using the official Ring App Store Knowledge MCP server",
  "prompt": "file://../prompts/ring.md",
  "mcpServers": {
    "ring-appstore-knowledge-mcp-server": {
      "type": "streamable-http",
      "url": "https://knowledge.appstore-mcp.ring.amazon.dev/mcp",
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": ["file://AGENTS.md", "file://README.md", "file://../steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*ring\\.amazon\\.dev.*", ".*docs\\.aws\\.amazon\\.com.*", ".*github\\.com.*"]
    }
  },
  "keyboardShortcut": "shift+r",
  "welcomeMessage": "Amazon Ring integration specialist ready. Ring App Store apps, device APIs, events/webhooks, auth — backed by the official ring-appstore-knowledge MCP. What are we building?",
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": ["git-defender*"],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": ["*ring.amazon.dev*", "*docs.aws.amazon.com*", "*github.com*"],
        "effect": "allow"
      }
    ],
    "policies": ["read-only-shell"]
  }
}
