{
  "name": "sap-abap",
  "description": "SAP ABAP development agent — Clean ABAP, ALV reports, BAPIs, data migration, CDS views, RAP, ABAP Unit testing",
  "prompt": "file://~/.kiro/prompts/sap-abap.md",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": false
    },
    "web-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md",
    "skill://~/.kiro/skills/sap-abap-patterns.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*github\\.com.*"]
    }
  },
  "keyboardShortcut": "ctrl+7",
  "welcomeMessage": "SAP ABAP specialist ready. Clean ABAP, ALV reports, BAPIs, data migration, CDS views, RAP, ABAP Unit. What ABAP program do we need?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  },
  "version": "2026.05.14"
}
