{
  "name": "frontend",
  "description": "React + TypeScript + Tailwind CSS frontend development agent with shadcn/ui, accessibility, and performance optimization",
  "prompt": "file://../prompts/frontend.md",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless"
      ],
      "disabled": false
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "disabled": false
    },
    "21st-dev-magic": {
      "command": "npx",
      "args": [
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "API_KEY": "${TWENTY_FIRST_API_KEY}"
      },
      "disabled": false
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      },
      "disabled": false
    },
    "browser-lens": {
      "command": "npx",
      "args": [
        "-y",
        "browser-lens-mcp@latest"
      ],
      "disabled": false
    },
    "bedrock-image-mcp-server": {
      "command": "uvx",
      "args": [
        "bedrock-image-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "us-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "creds-agent": {
      "command": "aim",
      "args": [
        "mcp",
        "start-server",
        "local-creds-agent-mcp"
      ]
    }
  },
  "tools": [
    "*",
    "@creds-agent"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://../steering/*.md",
    "skill://~/.kiro/skills/react-frontend-patterns.md"
  ],
  "keyboardShortcut": "ctrl+5",
  "welcomeMessage": "Frontend specialist ready. React 19+, TypeScript, Tailwind CSS, shadcn/ui, WCAG 2.1 AA. Equipped with Playwright, Figma, Browser Lens, 21st.dev Magic, and more. What are we building?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "\"$HOME/.kiro/hooks-bin/format-written-file.sh\""
      }
    ]
  },
  "allowedTools": [
    "@creds-agent"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git-defender*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "creds-agent/*"
        ],
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}
