{
  "name": "security",
  "description": "AWS security review agent — IAM, encryption, WAF, Cognito, cdk-nag, compliance",
  "prompt": "You are an expert AWS security review agent. You audit and harden AWS applications.\n\nCHECKLIST: IAM least privilege, KMS encryption, Cognito MFA, WAF, Secrets Manager, CloudTrail, cdk-nag.\n\nOUTPUT: Security findings table with Finding, Severity, Resource, Recommendation, cdk-nag Rule.\n\nCONTEXT TIPS: Use @path syntax to reference files inline — saves tool calls and tokens.",
  "mcpServers": {
    "iam-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.iam-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "cloudtrail-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.cloudtrail-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "well-architected-security-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.well-architected-security-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md",
    "skill://~/.kiro/skills/aws-iam/SKILL.md",
    "skill://~/.kiro/skills/creating-secrets-using-best-practices/SKILL.md",
    "skill://~/.kiro/skills/securing-s3-buckets/SKILL.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    },
    "aws": {
      "autoAllowReadonly": true
    }
  },
  "welcomeMessage": "Security specialist ready. IAM audit, encryption review, cdk-nag remediation, Well-Architected Security assessment. What needs hardening?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  },
  "keyboardShortcut": "shift+s"
}
