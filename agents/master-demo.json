{
  "name": "master-demo-single",
  "description": "Single-agent demo for live AWS serverless backend builds — no subagents, only aws-mcp-server (Agent Toolkit for AWS) + aws-serverless skill bundle. Lean variant of master-demo.",
  "prompt": "file://~/.kiro/prompts/master-demo-single.md",
  "mcpServers": {
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md",
    "skill://~/.kiro/skills/aws-serverless/SKILL.md",
    "skill://~/.kiro/skills/aws-serverless-patterns.md",
    "skill://~/.kiro/skills/connecting-lambda-to-api-gateway",
    "skill://~/.kiro/skills/connecting-lambda-to-dynamodb",
    "skill://~/.kiro/skills/cdk-infrastructure-patterns.md",
    "skill://~/.kiro/skills/deploy-on-aws.md",
    "skill://~/.kiro/skills/deploy.sh.template",
    "skill://~/.kiro/skills/gitignore.template",
    "skill://~/.kiro/skills/mcp-tool-discovery.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [
        ".*docs\\.aws\\.amazon\\.com.*",
        ".*github\\.com.*",
        ".*swagger\\.io.*",
        ".*openapi\\.org.*",
        ".*redoc\\.ly.*",
        ".*stoplight\\.io.*",
        ".*petstore\\.swagger\\.io.*"
      ]
    }
  },
  "keyboardShortcut": "ctrl+7",
  "welcomeMessage": "master-demo-single ready. Single-agent AWS serverless demo. aws-mcp-server only — no subagents, no extra MCPs. Same hard rules as master-demo. What are we demoing?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  }
}
