{
  "name": "master-demo",
  "description": "Single-agent demo for serverless backends. No subagents, only aws-mcp-server.",
  "prompt": "file://~/.kiro/prompts/master-demo.md",
  "mcpServers": {
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": [
    "*",
    "@creds-agent"
  ],
  "resources": [
    "file://README.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": [
        "git-defender.*"
      ]
    },
    "web_fetch": {
      "trusted": [
        ".*docs\\.aws\\.amazon\\.com.*",
        ".*github\\.com.*",
        ".*swagger\\.io.*",
        ".*openapi\\.org.*",
        ".*redoc\\.ly.*",
        ".*stoplight\\.io.*",
        ".*petstore\\.swagger\\.io.*"
      ]
    }
  },
  "keyboardShortcut": "shift+m",
  "welcomeMessage": "Demo mode ready. Single agent, serverless only, always CORS. What are we building?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  },
  "allowedTools": [
    "@creds-agent"
  ]
}
