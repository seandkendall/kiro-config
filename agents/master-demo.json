{
  "name": "master-demo",
  "description": "Single-agent demo for live AWS serverless backend builds — no subagents, only aws-mcp-server (Agent Toolkit for AWS) + aws-serverless skill bundle. Builds + deploys fast for demos.",
  "prompt": "file://../prompts/master-demo.md",
  "mcpServers": {
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "creds-agent": {
      "command": "aim",
      "args": ["mcp", "start-server", "local-creds-agent-mcp"]
    }
  },
  "tools": ["*", "@creds-agent"],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://../steering/*.md",
    "skill://~/.kiro/skills/aws-serverless/SKILL.md",
    "skill://~/.kiro/skills/aws-serverless-patterns.md",
    "skill://~/.kiro/skills/connecting-lambda-to-api-gateway",
    "skill://~/.kiro/skills/connecting-lambda-to-dynamodb",
    "skill://~/.kiro/skills/cdk-infrastructure-patterns.md",
    "skill://~/.kiro/skills/deploy-on-aws.md",
    "skill://~/.kiro/skills/deploy.sh.template",
    "skill://~/.kiro/skills/gitignore.template",
    "skill://~/.kiro/skills/mcp-tool-discovery.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [
        ".*docs\\.aws\\.amazon\\.com.*",
        ".*github\\.com.*",
        ".*swagger\\.io.*",
        ".*openapi\\.org.*",
        ".*redoc\\.ly.*",
        ".*stoplight\\.io.*",
        ".*petstore\\.swagger\\.io.*"
      ]
    }
  },
  "keyboardShortcut": "shift+m",
  "welcomeMessage": "master-demo ready. AWS serverless only. No UI/WAF/Resource-Groups/Powertools/X-Ray/cdk-nag/Kiro-Specs. Post-deploy CORS + endpoint verify. What are we demoing?",
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "fs_write",
      "action": {
        "type": "command",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      },
      "timeout": 10
    },
    {
      "name": "postToolUse-1",
      "trigger": "postToolUse",
      "matcher": "fs_write",
      "action": {
        "type": "command",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      },
      "timeout": 10
    }
  ],
  "allowedTools": ["@creds-agent"],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": ["git-defender*"],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*docs.aws.amazon.com*",
          "*github.com*",
          "*swagger.io*",
          "*openapi.org*",
          "*redoc.ly*",
          "*stoplight.io*",
          "*petstore.swagger.io*"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": ["creds-agent/*"],
        "effect": "allow"
      }
    ],
    "policies": ["read-only-shell"]
  }
}
