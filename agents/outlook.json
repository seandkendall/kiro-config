{
  "name": "outlook",
  "description": "Email analysis and summarization agent for Outlook",
  "prompt": "file://./prompts/outlook.md",
  "mcpServers": {
    "aws-outlook-mcp": {
      "command": "aws-outlook-mcp"
    }
  },
  "tools": ["*"],
  "toolAliases": {
    "outlook": "outlook-mcp-server"
  },
  "resources": ["file://AGENTS.md", "file://README.md", "file://~/.kiro/steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": "."
    }
  }
}
