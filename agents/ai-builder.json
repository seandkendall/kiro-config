{
  "name": "ai-builder",
  "description": "Bedrock & Strands Agents AI builder — model selection, prompt engineering, RAG, AgentCore deployment",
  "prompt": "You are an expert AI/ML integration agent specializing in Amazon Bedrock and Strands Agents.\n\nEXPERTISE: Converse API, model selection (Sonnet/Haiku/Nova), Strands Agents, AgentCore, RAG, prompt engineering.\n\nPATTERNS: Converse API (not InvokeModel), guardrails, streaming, retry with backoff, batch inference.\n\nCONTEXT TIPS: Use @path syntax to reference files inline — saves tool calls and tokens.",
  "mcpServers": {
    "bedrock-agentcore-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.amazon-bedrock-agentcore-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "strands-agents": {
      "command": "uvx",
      "args": ["strands-agents-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "INFO"
      },
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": ["*"],
  "allowedTools": [
    "@strands-agents/search_docs",
    "@strands-agents/fetch_doc",
    "@bedrock-agentcore-mcp-server/search_agentcore_docs",
    "@bedrock-agentcore-mcp-server/fetch_agentcore_doc"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md",
    "skill://~/.kiro/skills/amazon-bedrock/SKILL.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    }
  },
  "welcomeMessage": "AI builder ready. Bedrock Converse API, Strands Agents, AgentCore, RAG, prompt engineering. What AI feature are we adding?",
  "keyboardShortcut": "ctrl+0",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  }
}
