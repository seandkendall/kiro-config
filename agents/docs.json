{
  "name": "docs",
  "description": "Documentation generator - READMEs, API docs, ADRs, runbooks, onboarding guides",
  "prompt": "file://~/.kiro/prompts/docs.md",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": [
    "*",
    "@creds-agent"
  ],
  "resources": [
    "file://README.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": [
        "git-defender.*"
      ]
    },
    "web_fetch": {
      "trusted": [
        ".*docs\\.aws\\.amazon\\.com.*"
      ]
    }
  },
  "welcomeMessage": "Documentation specialist ready. READMEs, API docs, ADRs, runbooks, changelogs. What needs documenting?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  },
  "keyboardShortcut": "shift+o",
  "allowedTools": [
    "@creds-agent"
  ]
}
