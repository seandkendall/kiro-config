{
  "name": "image-gen",
  "description": "Image generation and editing — UI assets, logos, icons, mockups, marketing images, virtual try-on, sketch-to-2D, ambient art (Samsung Frame TV) via Bedrock (Nova Canvas + Stable Diffusion 3.5)",
  "prompt": "file://~/.kiro/prompts/image-gen.md",
  "mcpServers": {
    "web-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "disabled": false
    },
    "bedrock-image-mcp-server": {
      "command": "uvx",
      "args": ["bedrock-image-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": ["file://AGENTS.md", "file://README.md", "file://~/.kiro/steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    }
  },
  "welcomeMessage": "Image generation + editing ready. Nova Canvas + Stable Diffusion 3.5 via Bedrock. Logos, icons, mockups, virtual try-on, ambient art. What images do you need?",
  "keyboardShortcut": "shift+i"
}
