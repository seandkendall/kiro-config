{
  "name": "shopify",
  "description": "Shopify + AWS serverless integration builder",
  "prompt": "file://../prompts/shopify.md",
  "mcpServers": {
    "shopify-dev-mcp": {
      "command": "npx",
      "args": ["-y", "@shopify/dev-mcp@latest"]
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "creds-agent": {
      "command": "aim",
      "args": ["mcp", "start-server", "local-creds-agent-mcp"]
    }
  },
  "tools": ["*", "@creds-agent"],
  "resources": ["file://AGENTS.md", "file://README.md", "file://../steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    }
  },
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "fs_write",
      "action": {
        "type": "command",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      },
      "timeout": 10
    }
  ],
  "allowedTools": ["@creds-agent"],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": ["git-defender*"],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": ["creds-agent/*"],
        "effect": "allow"
      }
    ],
    "policies": ["read-only-shell"]
  }
}
