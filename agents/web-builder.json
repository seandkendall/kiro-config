{
  "name": "web-builder",
  "description": "React + AWS serverless web app builder with CDK, S3, CloudFront, Cognito",
  "prompt": "file://~/.kiro/prompts/web-builder.md",
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--channel=canary",
        "--autoConnect",
        "--headless=true"
      ],
      "disabled": false
    },
    "bedrock-image-mcp-server": {
      "command": "uvx",
      "args": ["bedrock-image-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": false
    },
    "21st-dev-magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "env": {
        "API_KEY": "${TWENTY_FIRST_API_KEY}"
      },
      "disabled": false
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"],
      "disabled": false
    },
    "browser-lens": {
      "command": "npx",
      "args": ["-y", "browser-lens-mcp@latest"],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated"],
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": ["file://AGENTS.md", "file://README.md", "file://~/.kiro/steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "aws": {
      "autoAllowReadonly": true
    },
    "subagent": {
      "availableAgents": [
        "ai-builder",
        "architect",
        "data",
        "devops",
        "docs",
        "frontend",
        "image-gen",
        "security",
        "serverless",
        "testing"
      ],
      "trustedAgents": [
        "ai-builder",
        "architect",
        "data",
        "devops",
        "docs",
        "frontend",
        "image-gen",
        "security",
        "serverless",
        "testing"
      ]
    }
  },
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  },
  "keyboardShortcut": "shift+w",
  "welcomeMessage": "Web builder ready. React + AWS full-stack apps. I delegate UI work to the frontend subagent, backend to serverless, and AI features to ai-builder. What are we building?"
}
