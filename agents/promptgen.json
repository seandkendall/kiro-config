{
  "name": "promptgen",
  "description": "Generates agentic prompts for building and deploying full-stack AWS applications",
  "prompt": "file://../prompts/promptgen.md",
  "mcpServers": {
    "web-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "creds-agent": {
      "command": "aim",
      "args": ["mcp", "start-server", "local-creds-agent-mcp"]
    }
  },
  "tools": ["*", "@creds-agent"],
  "resources": ["file://AGENTS.md", "file://README.md", "file://../steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    }
  },
  "allowedTools": ["@creds-agent"],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": ["git-defender*"],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": ["*docs.aws.amazon.com*"],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": ["creds-agent/*"],
        "effect": "allow"
      }
    ]
  }
}
