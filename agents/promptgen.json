{
  "name": "promptgen",
  "description": "Generates agentic prompts for building and deploying full-stack AWS applications",
  "prompt": "file://~/.kiro/prompts/promptgen.md",
  "mcpServers": {
    "aws-documentation-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "web-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": ["file://AGENTS.md", "file://README.md", "file://~/.kiro/steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    }
  }
}
