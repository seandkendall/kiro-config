{
  "name": "master",
  "description": "Master orchestrator agent \u2014 routes any task to the right specialist subagent",
  "prompt": "file://~/.kiro/prompts/master.md",
  "mcpServers": {
    "web-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false
    },
    "sequentialthinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "bedrock-image-mcp-server": {
      "command": "uvx",
      "args": ["bedrock-image-mcp-server@latest"],
      "env": {
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md",
    "skill://~/.kiro/skills/cdk-infrastructure-patterns.md",
    "skill://~/.kiro/skills/react-frontend-patterns.md",
    "skill://~/.kiro/skills/aws-serverless-patterns.md",
    "skill://~/.kiro/skills/testing-patterns.md",
    "skill://~/.kiro/skills/mcp-tool-discovery.md"
  ],
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "serverless",
        "frontend",
        "testing",
        "architect",
        "ai-builder",
        "devops",
        "data",
        "security",
        "docs",
        "image-gen",
        "research",
        "google-workspace",
        "web-builder"
      ],
      "trustedAgents": [
        "serverless",
        "frontend",
        "testing",
        "architect",
        "ai-builder",
        "devops",
        "data",
        "security",
        "docs",
        "image-gen",
        "research",
        "google-workspace",
        "web-builder"
      ]
    },
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*", ".*github\\.com.*"]
    }
  },
  "keyboardShortcut": "ctrl+1",
  "welcomeMessage": "Master orchestrator ready. I route any task to the right specialist subagent (13 available), generate images and diagrams, and write deploy.sh scripts. What are we building?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  }
}
