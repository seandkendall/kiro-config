{
  "name": "master",
  "description": "Master orchestrator agent — routes any task to the right specialist subagent (no gaming)",
  "prompt": "file://~/.kiro/prompts/master.md",
  "mcpServers": {
    "web-search": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ],
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false
    },
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": [
    "*"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md",
    "skill://~/.kiro/skills/cdk-infrastructure-patterns.md",
    "skill://~/.kiro/skills/react-frontend-patterns.md",
    "skill://~/.kiro/skills/aws-serverless-patterns.md",
    "skill://~/.kiro/skills/testing-patterns.md"
  ],
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "serverless",
        "frontend",
        "testing",
        "cypress",
        "architect",
        "ai-builder",
        "devops",
        "data",
        "security",
        "docs",
        "image-gen",
        "research",
        "sap-abap",
        "google-workspace"
      ],
      "trustedAgents": [
        "serverless",
        "frontend",
        "testing",
        "cypress",
        "architect",
        "ai-builder",
        "devops",
        "data",
        "security",
        "docs",
        "image-gen",
        "research",
        "sap-abap",
        "google-workspace"
      ]
    },
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": [
        "git-defender.*"
      ]
    },
    "web_fetch": {
      "trusted": [
        ".*docs\\.aws\\.amazon\\.com.*",
        ".*github\\.com.*"
      ]
    }
  },
  "keyboardShortcut": "ctrl+1",
  "welcomeMessage": "Master orchestrator ready. I route tasks to specialist subagents — serverless, frontend, testing, architect, AI, devops, data, security, docs, and more. What are we building?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      },
      {
        "matcher": "fs_write",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  }
}
