{
  "name": "master",
  "description": "Master orchestrator agent \u2014 routes any task to the right specialist subagent",
  "prompt": "file://../prompts/master.md",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "bedrock-image-mcp-server": {
      "command": "uvx",
      "args": [
        "bedrock-image-mcp-server@latest"
      ],
      "env": {
        "AWS_REGION": "us-west-2",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "creds-agent": {
      "command": "aim",
      "args": [
        "mcp",
        "start-server",
        "local-creds-agent-mcp"
      ]
    }
  },
  "tools": [
    "*",
    "@creds-agent"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "skill://~/.kiro/skills/cdk-infrastructure-patterns.md",
    "skill://~/.kiro/skills/react-frontend-patterns.md",
    "skill://~/.kiro/skills/aws-serverless-patterns.md",
    "skill://~/.kiro/skills/testing-patterns.md",
    "skill://~/.kiro/skills/mcp-tool-discovery.md"
  ],
  "toolsSettings": {
    "subagent": {
      "availableAgents": [
        "accounting",
        "ai-builder",
        "architect",
        "data",
        "devops",
        "docs",
        "frontend",
        "google-workspace",
        "image-gen",
        "ios",
        "ios-testing",
        "promptgen",
        "reinvent",
        "research",
        "security",
        "serverless",
        "shopify",
        "stocks",
        "testing",
        "web-builder"
      ],
      "trustedAgents": [
        "accounting",
        "ai-builder",
        "architect",
        "data",
        "devops",
        "docs",
        "frontend",
        "google-workspace",
        "image-gen",
        "ios",
        "ios-testing",
        "promptgen",
        "reinvent",
        "research",
        "security",
        "serverless",
        "shopify",
        "stocks",
        "testing",
        "web-builder"
      ]
    }
  },
  "keyboardShortcut": "ctrl+1",
  "welcomeMessage": "Master orchestrator ready. I route any task to the right specialist subagent (20 available), generate images and diagrams, and write deploy.sh scripts. What are we building?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "\"$HOME/.kiro/hooks-bin/format-written-file.sh\""
      }
    ]
  },
  "allowedTools": [
    "@creds-agent"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git-defender*"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*docs.aws.amazon.com*",
          "*github.com*"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "accounting",
          "ai-builder",
          "architect",
          "data",
          "devops",
          "docs",
          "frontend",
          "google-workspace",
          "image-gen",
          "ios",
          "ios-testing",
          "promptgen",
          "reinvent",
          "research",
          "security",
          "serverless",
          "shopify",
          "stocks",
          "testing",
          "web-builder"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "creds-agent/*"
        ],
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}
