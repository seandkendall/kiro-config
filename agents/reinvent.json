{
  "name": "reinvent",
  "description": "AWS Serverless backend builder with SAM, Lambda, API Gateway, DynamoDB",
  "prompt": "file://~/.kiro/prompts/reinvent.md",
  "mcpServers": {
    "aws-serverless-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-serverless-mcp-server@latest",
        "--allow-write",
        "--allow-sensitive-data-access"
      ],
      "disabled": false
    },
    "aws-documentation-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-documentation-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    }
  },
  "tools": ["*"],
  "toolAliases": {
    "docs": "aws-documentation-mcp-server",
    "sam": "aws-serverless-mcp-server"
  },
  "resources": ["file://AGENTS.md", "file://README.md", "file://~/.kiro/steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    }
  }
}
