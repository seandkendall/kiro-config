{
  "name": "image-editor",
  "description": "Image generation agent for apparel, virtual tryon, and art using Nova Canvas and Stability AI",
  "prompt": "file://~/.kiro/prompts/image-editor.md",
  "mcpServers": {
    "web-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"],
      "disabled": false
    },
    "bedrock-image-mcp-server": {
      "command": "uvx",
      "args": ["bedrock-image-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": ["*"],
  "resources": ["file://AGENTS.md", "file://README.md", "file://~/.kiro/steering/*.md"],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    }
  },
  "version": "2026.05.14"
}
