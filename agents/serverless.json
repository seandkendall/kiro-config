{
  "name": "serverless",
  "description": "AWS Serverless development agent — Lambda, API Gateway, DynamoDB, Step Functions, EventBridge with Powertools and X-Ray",
  "prompt": "file://../prompts/serverless.md",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "creds-agent": {
      "command": "aim",
      "args": ["mcp", "start-server", "local-creds-agent-mcp"]
    }
  },
  "tools": ["*", "@creds-agent"],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://../steering/*.md",
    "skill://~/.kiro/skills/cdk-infrastructure-patterns.md",
    "skill://~/.kiro/skills/aws-serverless-patterns.md",
    "skill://~/.kiro/skills/connecting-lambda-to-api-gateway/SKILL.md",
    "skill://~/.kiro/skills/connecting-lambda-to-dynamodb/SKILL.md",
    "skill://~/.kiro/skills/debugging-lambda-timeouts/SKILL.md",
    "skill://~/.kiro/skills/aws-serverless/SKILL.md",
    "skill://~/.kiro/skills/aws-messaging-and-streaming/SKILL.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": ["git-defender.*"]
    },
    "web_fetch": {
      "trusted": [".*docs\\.aws\\.amazon\\.com.*"]
    },
    "aws": {
      "autoAllowReadonly": true
    }
  },
  "keyboardShortcut": "ctrl+4",
  "welcomeMessage": "Serverless specialist ready. Lambda, API Gateway, DynamoDB, Step Functions, EventBridge — all with Powertools and X-Ray. What are we building?",
  "hooks": [
    {
      "name": "postToolUse-0",
      "trigger": "postToolUse",
      "matcher": "fs_write",
      "action": {
        "type": "command",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      },
      "timeout": 10
    },
    {
      "name": "postToolUse-1",
      "trigger": "postToolUse",
      "matcher": "fs_write",
      "action": {
        "type": "command",
        "command": "shfmt -w \"$FILEPATH\" 2>/dev/null || true"
      },
      "timeout": 10
    }
  ],
  "allowedTools": ["@creds-agent"],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": ["git-defender*"],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": ["*docs.aws.amazon.com*"],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": ["creds-agent/*"],
        "effect": "allow"
      }
    ],
    "policies": ["read-only-shell"]
  }
}
