{
  "name": "serverless",
  "description": "AWS Serverless development agent \u2014 Lambda, API Gateway, DynamoDB, Step Functions, EventBridge with Powertools and X-Ray",
  "prompt": "file://../prompts/serverless.md",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    },
    "creds-agent": {
      "command": "aim",
      "args": [
        "mcp",
        "start-server",
        "local-creds-agent-mcp"
      ]
    }
  },
  "tools": [
    "*",
    "@creds-agent"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://../steering/*.md",
    "skill://~/.kiro/skills/cdk-infrastructure-patterns.md",
    "skill://~/.kiro/skills/aws-serverless-patterns.md"
  ],
  "keyboardShortcut": "ctrl+4",
  "welcomeMessage": "Serverless specialist ready. Lambda, API Gateway, DynamoDB, Step Functions, EventBridge \u2014 all with Powertools and X-Ray. What are we building?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "\"$HOME/.kiro/hooks-bin/format-written-file.sh\""
      }
    ]
  },
  "allowedTools": [
    "@creds-agent"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git-defender*"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*docs.aws.amazon.com*"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "creds-agent/*"
        ],
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}
