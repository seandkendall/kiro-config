{
  "name": "data",
  "description": "Data modeling and database design agent - DynamoDB, Postgres, Aurora, data migration, ETL",
  "prompt": "file://~/.kiro/prompts/data.md",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    },
    "aws-mcp-server": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "disabled": false
    }
  },
  "tools": [
    "*",
    "@creds-agent"
  ],
  "resources": [
    "file://README.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true,
      "deniedCommands": [
        "git-defender.*"
      ]
    },
    "web_fetch": {
      "trusted": [
        ".*docs\\.aws\\.amazon\\.com.*"
      ]
    },
    "aws": {
      "autoAllowReadonly": true
    }
  },
  "welcomeMessage": "Data specialist ready. DynamoDB single-table design, Postgres schemas, Aurora, migrations, ETL. What data model do we need?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  },
  "keyboardShortcut": "shift+d",
  "allowedTools": [
    "@creds-agent"
  ]
}
