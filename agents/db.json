{
  "name": "db",
  "description": "Postgres DBA for creating demo databases with realistic sample data",
  "prompt": "file://./prompts/db.md",
  "mcpServers": {
    "postgres-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.postgres-mcp-server@latest",
        "--allow_write_query"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    }
  },
  "tools": [
    "*"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "deniedCommands": [
        "git-defender.*"
      ]
    }
  }
}
