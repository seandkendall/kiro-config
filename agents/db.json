{
  "name": "db",
  "description": "Postgres DBA for creating demo databases with realistic sample data",
  "prompt": "file://~/.kiro/prompts/db.md",
  "mcpServers": {},
  "tools": [
    "*"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "deniedCommands": [
        "git-defender.*"
      ]
    }
  },
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "ruff check --fix --quiet \"$FILEPATH\" 2>/dev/null; ruff format --quiet \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  }
}
