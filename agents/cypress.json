{
  "name": "cypress",
  "description": "Cypress E2E testing agent — writes, runs, and debugs Cypress tests following official best practices",
  "prompt": "file://./prompts/cypress.md",
  "mcpServers": {
    "cypress-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@jprealini/cypress-mcp"
      ],
      "disabled": false
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "disabled": false
    }
  },
  "tools": [
    "*"
  ],
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://~/.kiro/steering/*.md",
    "skill://~/.kiro/skills/testing-patterns.md"
  ],
  "toolsSettings": {
    "shell": {
      "timeout": 300,
      "working_directory": ".",
      "autoAllowReadonly": true
    }
  },
  "welcomeMessage": "Cypress E2E specialist ready. Page Objects, data-cy selectors, 100% coverage target. Which app flows need E2E tests?",
  "hooks": {
    "postToolUse": [
      {
        "matcher": "fs_write",
        "command": "npx prettier --write \"$FILEPATH\" 2>/dev/null || true"
      }
    ]
  }
}
