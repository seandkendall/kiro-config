{
  "name": "clean",
  "description": "macOS disk cleanup analyzer - finds space hogs without deleting anything",
  "prompt": "file://./prompts/clean.md",
  "mcpServers": {},
  "tools": ["@builtin"],
  "allowedTools": ["read", "shell", "glob", "grep"],
  "toolsSettings": {
    "shell": {
      "autoAllowReadonly": true,
      "deniedCommands": [
        "rm .*",
        "trash .*",
        "srm .*",
        "mv .*",
        "sudo rm.*",
        "sudo trash.*"
      ]
    },
    "write": {
      "deniedPaths": ["**/*"],
      "fallbackAction": "deny"
    }
  }
}
