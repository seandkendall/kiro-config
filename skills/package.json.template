{
  "_comment_": [
    "Sample package.json template for React + Playwright projects deployed via this Kiro CLI config.",
    "Copy to your project root as package.json and customize 'name', 'version', and 'description'.",
    "",
    "Aligns with the v0.12.0 standards:",
    "  - Vite for build tooling (steering/tech.md)",
    "  - React 19+ with TypeScript strict mode",
    "  - Vitest + React Testing Library for unit/component tests",
    "  - Playwright for E2E (data-testid selectors, storageState auth)",
    "  - @axe-core/playwright for accessibility assertions inside specs",
    "  - monocart-coverage-reports for V8 coverage (target 100%)",
    "  - shadcn/ui via the shadcn MCP (no direct dependency listed; use 'npx shadcn add <component>')",
    "  - react-hook-form + zod for forms (development-workflow.md)",
    "  - TanStack Query for server state, Zustand for client state",
    "",
    "Version pins below were refreshed to the latest releases on 2026-06-23. Per",
    "development-workflow.md, dependencies are upgraded to latest daily — re-run",
    "'npm install <pkg>@latest' and commit the lockfile.",
    "",
    "HEADS UP — these are MAJOR upgrades with breaking changes; review each migration guide",
    "before adopting in an existing project: React 19, React Router 7, Zod 4, Tailwind CSS 4",
    "(CSS-first config via @tailwindcss/postcss; autoprefixer no longer required), Vite 8,",
    "TypeScript 6, ESLint 10 (flat config), Vitest 4, @hookform/resolvers 5, jsdom 29."
  ],

  "name": "your-project-name",
  "version": "0.1.0",
  "description": "React + AWS serverless project deployed via deploy.sh",
  "type": "module",
  "private": true,

  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",

    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",

    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:codegen": "playwright codegen $BASE_URL",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",

    "build:emails": "node build-emails.mjs"
  },

  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",

    "@tanstack/react-query": "^5.101.1",
    "zustand": "^5.0.14",

    "react-hook-form": "^7.80.0",
    "zod": "^4.4.3",
    "@hookform/resolvers": "^5.4.0",

    "@aws-amplify/auth": "^6.20.0",
    "amazon-cognito-identity-js": "^6.3.18",

    "tailwind-merge": "^3.6.0",
    "clsx": "^2.1.1"
  },

  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",

    "vite": "^8.1.0",
    "@vitejs/plugin-react": "^6.0.3",

    "tailwindcss": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.1",
    "postcss": "^8.5.15",
    "autoprefixer": "^10.5.1",

    "vitest": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",

    "@playwright/test": "^1.61.1",
    "@axe-core/playwright": "^4.12.1",
    "monocart-coverage-reports": "^2.12.12",

    "eslint": "^10.5.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-config-prettier": "^10.1.8",

    "prettier": "^3.8.4",

    "juice": "^12.1.1"
  },

  "engines": {
    "node": ">=24.0.0"
  }
}
