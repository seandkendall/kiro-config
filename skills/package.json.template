{
  "_comment_": [
    "Sample package.json template for React + Playwright projects deployed via this Kiro CLI config.",
    "Copy to your project root as package.json and customize 'name', 'version', and 'description'.",
    "",
    "Aligns with the v0.12.0 standards:",
    "  - Vite for build tooling (steering/tech.md)",
    "  - React 18+ with TypeScript strict mode",
    "  - Vitest + React Testing Library for unit/component tests",
    "  - Playwright for E2E (data-testid selectors, storageState auth)",
    "  - @axe-core/playwright for accessibility assertions inside specs",
    "  - monocart-coverage-reports for V8 coverage (target 100%)",
    "  - shadcn/ui via the shadcn MCP (no direct dependency listed; use 'npx shadcn add <component>')",
    "  - react-hook-form + zod for forms (development-workflow.md)",
    "  - TanStack Query for server state, Zustand for client state",
    "",
    "Versions are placeholders — run 'npm install <pkg>@latest' for each then commit the lockfile.",
    "Per development-workflow.md, dependencies are upgraded to latest daily."
  ],

  "name": "your-project-name",
  "version": "0.1.0",
  "description": "React + AWS serverless project deployed via deploy.sh",
  "type": "module",
  "private": true,

  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",

    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",

    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:codegen": "playwright codegen $BASE_URL",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",

    "build:emails": "node build-emails.mjs"
  },

  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.27.0",

    "@tanstack/react-query": "^5.59.0",
    "zustand": "^5.0.0",

    "react-hook-form": "^7.53.0",
    "zod": "^3.23.0",
    "@hookform/resolvers": "^3.9.0",

    "@aws-amplify/auth": "^6.5.0",
    "amazon-cognito-identity-js": "^6.3.0",

    "tailwind-merge": "^2.5.0",
    "clsx": "^2.1.0"
  },

  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",

    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",

    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",

    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.0",
    "jsdom": "^25.0.0",

    "@playwright/test": "^1.48.0",
    "@axe-core/playwright": "^4.10.0",
    "monocart-coverage-reports": "^2.10.0",

    "eslint": "^9.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-config-prettier": "^9.1.0",

    "prettier": "^3.3.0",

    "premailer": "^4.0.0",
    "juice": "^11.0.0"
  },

  "engines": {
    "node": ">=20.0.0"
  }
}
