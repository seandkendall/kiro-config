#!/usr/bin/env bash
#
# deploy.sh — Deploy/teardown an AWS CDK stack with frontend
#
# Contract (see steering/aws-standards.md → "deploy.sh"):
#   --profile <name>   AWS profile (defaults to "default")
#   --domain  <fqdn>   Custom domain (saved per profile, recalled on next run)
#   --delete           Tear down the stack AND deep-clean orphaned resources
#   -y / --yes         Auto-confirm — no prompts
#   -h / --help        Show usage
#
# Per-profile state lives in .deploy-state.json (gitignored). When you re-run
# deploy.sh without --domain, the value saved for the current profile is used.
#
# Designed to work with Kiro CLI's agent output side channels (2.3.0+):
#   $AGENT_DISPLAY_OUT — verbose logs go to user TUI but NOT into agent context
#   $AGENT_CONTEXT_OUT — structured summary lines go to agent_notes
#

set -euo pipefail

# ----------------------------------------------------------------------------
# Argument parsing
# ----------------------------------------------------------------------------

PROFILE=""
DOMAIN=""
DELETE=false
ASSUME_YES=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="$2"
      shift 2
      ;;
    --domain)
      DOMAIN="$2"
      shift 2
      ;;
    --delete)
      DELETE=true
      shift
      ;;
    -y|--yes)
      ASSUME_YES=true
      shift
      ;;
    -h|--help)
      grep "^#" "$0" | head -25 | sed 's/^# \?//'
      exit 0
      ;;
    *)
      echo "Unknown flag: $1" >&2
      exit 1
      ;;
  esac
done

PROFILE="${PROFILE:-default}"

# ----------------------------------------------------------------------------
# Per-profile state (.deploy-state.json)
# ----------------------------------------------------------------------------

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
STATE_FILE="$PROJECT_ROOT/.deploy-state.json"

# Initialize state file if missing
if [[ ! -f "$STATE_FILE" ]]; then
  echo "{}" > "$STATE_FILE"
fi

# Helper: read a saved value for the current profile (uses python; jq is optional)
read_state() {
  local key="$1"
  python3 -c "
import json, sys
try:
    with open('$STATE_FILE') as f: d = json.load(f)
    print(d.get('$PROFILE', {}).get('$key', ''))
except Exception:
    print('')
"
}

# Helper: write a value for the current profile
write_state() {
  local key="$1"
  local value="$2"
  python3 -c "
import json
with open('$STATE_FILE') as f: d = json.load(f)
d.setdefault('$PROFILE', {})['$key'] = '$value'
with open('$STATE_FILE', 'w') as f: json.dump(d, f, indent=2)
"
}

# Recall domain if not passed on CLI
if [[ -z "$DOMAIN" ]]; then
  DOMAIN=$(read_state domain)
fi

# Save domain for this profile
if [[ -n "$DOMAIN" ]]; then
  write_state domain "$DOMAIN"
fi

# ----------------------------------------------------------------------------
# Output channels (Kiro CLI side channels when agent-invoked, else stderr)
# ----------------------------------------------------------------------------

DISPLAY_OUT="${AGENT_DISPLAY_OUT:-/dev/stderr}"
CONTEXT_OUT="${AGENT_CONTEXT_OUT:-/dev/null}"

verbose() { tee "$DISPLAY_OUT" > /dev/null; }
note()    { echo "$1" >> "$CONTEXT_OUT"; }

# Helper: prompt unless -y was passed. Returns 0 to proceed, 1 to abort.
confirm() {
  local msg="$1"
  if $ASSUME_YES; then
    return 0
  fi
  read -r -p "$msg [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]]
}

# ----------------------------------------------------------------------------
# Project paths (customize per project)
# ----------------------------------------------------------------------------

CDK_DIR="$PROJECT_ROOT/cdk-backend"
FRONTEND_DIR="$PROJECT_ROOT/frontend"
PROJECT_NAME=$(basename "$PROJECT_ROOT")  # used for tag-based resource discovery

# ----------------------------------------------------------------------------
# Deep teardown — runs on --delete
# ----------------------------------------------------------------------------

if $DELETE; then
  echo "==> About to DESTROY stack and deep-clean owned resources"
  echo "    Profile: $PROFILE"
  [[ -n "$DOMAIN" ]] && echo "    Domain:  $DOMAIN"
  echo "    Project tag (used for resource discovery): project=$PROJECT_NAME"
  echo ""

  # Pre-flight: list resources tagged with this project (multi-project safety)
  if ! $ASSUME_YES; then
    echo "Resources tagged with project=$PROJECT_NAME (these will be deleted):"
    aws resourcegroupstaggingapi get-resources \
      --tag-filters "Key=project,Values=$PROJECT_NAME" \
      --profile "$PROFILE" \
      --query 'ResourceTagMappingList[*].ResourceARN' \
      --output table 2>/dev/null | verbose || true
    echo ""
  fi

  if ! confirm "Destroy stack and deep-clean associated resources?"; then
    echo "Aborted."
    exit 1
  fi

  echo "==> cdk destroy"
  cd "$CDK_DIR"
  cdk destroy --all --profile "$PROFILE" --force 2>&1 | verbose

  # Deep cleanup — by project tag, not by name prefix (multi-project safety)
  echo "==> Deep cleanup of orphaned resources"

  # 1. Empty + delete S3 buckets owned by this project
  for bucket in $(aws s3api list-buckets --profile "$PROFILE" \
    --query 'Buckets[].Name' --output text 2>/dev/null); do
    tags=$(aws s3api get-bucket-tagging --bucket "$bucket" --profile "$PROFILE" \
      --query "TagSet[?Key=='project'].Value" --output text 2>/dev/null || echo "")
    if [[ "$tags" == "$PROJECT_NAME" ]]; then
      echo "  Emptying + deleting S3 bucket: $bucket"
      aws s3 rm "s3://$bucket" --recursive --profile "$PROFILE" 2>&1 | verbose || true
      aws s3api delete-bucket --bucket "$bucket" --profile "$PROFILE" 2>&1 | verbose || true
    fi
  done

  # 2. Delete CloudWatch log groups owned by this project
  for log_group in $(aws logs describe-log-groups --profile "$PROFILE" \
    --query "logGroups[?contains(logGroupName, '$PROJECT_NAME')].logGroupName" \
    --output text 2>/dev/null); do
    # Verify by tag before deleting (defense against name collisions)
    tags=$(aws logs list-tags-log-group --log-group-name "$log_group" --profile "$PROFILE" \
      --query "tags.project" --output text 2>/dev/null || echo "")
    if [[ "$tags" == "$PROJECT_NAME" ]]; then
      echo "  Deleting log group: $log_group"
      aws logs delete-log-group --log-group-name "$log_group" --profile "$PROFILE" 2>&1 | verbose || true
    fi
  done

  # 3. Route53: delete only records this stack created. Strategy: query the
  #    hosted zone for the project's domain, find any RecordSets whose Name
  #    matches the stack's domain, and delete them by name+type after
  #    confirming with the user. The hosted zone itself is NEVER deleted —
  #    it is treated as shared infrastructure across projects in the account.
  if [[ -n "$DOMAIN" ]]; then
    # Strip the leftmost subdomain to get the apex zone name
    # (e.g., d1.app.example.com -> app.example.com -> example.com)
    ZONE_NAME="$DOMAIN"
    while [[ "$ZONE_NAME" == *.* ]]; do
      CANDIDATE_ID=$(aws route53 list-hosted-zones-by-name \
        --dns-name "$ZONE_NAME" \
        --profile "$PROFILE" \
        --query "HostedZones[?Name=='${ZONE_NAME}.'].Id | [0]" \
        --output text 2>/dev/null | sed 's|/hostedzone/||')
      if [[ -n "$CANDIDATE_ID" && "$CANDIDATE_ID" != "None" ]]; then
        ZONE_ID="$CANDIDATE_ID"
        break
      fi
      ZONE_NAME="${ZONE_NAME#*.}"
    done

    if [[ -n "${ZONE_ID:-}" ]]; then
      # Records still present for the deployed domain are orphans from
      # cdk destroy (CDK should have cleaned them, but we verify).
      RECORDS=$(aws route53 list-resource-record-sets \
        --hosted-zone-id "$ZONE_ID" \
        --profile "$PROFILE" \
        --query "ResourceRecordSets[?Name=='${DOMAIN}.']" \
        --output json 2>/dev/null || echo "[]")

      if [[ "$RECORDS" != "[]" && -n "$RECORDS" ]]; then
        echo "  Found Route53 records still present for $DOMAIN:"
        echo "$RECORDS" | python3 -c "
import sys, json
for r in json.load(sys.stdin):
    print(f\"      {r['Type']:6s} {r['Name']}\")
" 2>/dev/null || true

        if confirm "Delete these Route53 records (zone $ZONE_ID will NOT be deleted)?"; then
          # Build a Route53 change-batch with DELETE actions
          BATCH=$(echo "$RECORDS" | python3 -c "
import sys, json
records = json.load(sys.stdin)
print(json.dumps({'Changes': [{'Action': 'DELETE', 'ResourceRecordSet': r} for r in records]}))
" 2>/dev/null)
          if [[ -n "$BATCH" ]]; then
            TMPFILE=$(mktemp -t route53-XXXXXX.json)
            echo "$BATCH" > "$TMPFILE"
            aws route53 change-resource-record-sets \
              --hosted-zone-id "$ZONE_ID" \
              --change-batch "file://$TMPFILE" \
              --profile "$PROFILE" 2>&1 | verbose || true
            rm -f "$TMPFILE"
            echo "  ✓ Route53 records deleted from zone $ZONE_ID"
          fi
        else
          echo "  Skipped Route53 cleanup. Records remain in zone $ZONE_ID."
        fi
      else
        echo "  ✓ No orphaned Route53 records for $DOMAIN"
      fi
    fi
  fi

  # 4. ACM certificates owned exclusively by this project
  for cert_arn in $(aws acm list-certificates --region us-east-1 --profile "$PROFILE" \
    --query 'CertificateSummaryList[*].CertificateArn' --output text 2>/dev/null); do
    tags=$(aws acm list-tags-for-certificate --certificate-arn "$cert_arn" \
      --region us-east-1 --profile "$PROFILE" \
      --query "Tags[?Key=='project'].Value" --output text 2>/dev/null || echo "")
    if [[ "$tags" == "$PROJECT_NAME" ]]; then
      echo "  Deleting ACM cert: $cert_arn"
      aws acm delete-certificate --certificate-arn "$cert_arn" \
        --region us-east-1 --profile "$PROFILE" 2>&1 | verbose || true
    fi
  done

  note "Stack DESTROYED for profile $PROFILE; deep cleanup complete"
  echo "✓ Teardown complete"
  exit 0
fi

# ----------------------------------------------------------------------------
# Pre-deployment quality gate
# ----------------------------------------------------------------------------

echo "==> Running pre-deployment quality gate"

if [[ -d "$FRONTEND_DIR" ]] && [[ -f "$FRONTEND_DIR/package.json" ]]; then
  echo "  Linting frontend..."
  (cd "$FRONTEND_DIR" && npm run lint 2>&1) | verbose
fi

if [[ -d "$CDK_DIR" ]]; then
  echo "  Linting Python..."
  (cd "$CDK_DIR" && ruff check . 2>&1) | verbose || { echo "✗ ruff failed" >&2; exit 1; }
fi

if [[ -d "$CDK_DIR/tests" ]] || [[ -d "$CDK_DIR/lambda" ]]; then
  echo "  Running pytest..."
  (cd "$CDK_DIR" && pytest -q 2>&1) | verbose || { echo "✗ pytest failed" >&2; exit 1; }
fi

if [[ -d "$FRONTEND_DIR" ]] && grep -q "vitest\|jest" "$FRONTEND_DIR/package.json" 2>/dev/null; then
  echo "  Running frontend tests..."
  (cd "$FRONTEND_DIR" && npm test -- --run 2>&1) | verbose || { echo "✗ frontend tests failed" >&2; exit 1; }
fi

echo "✓ Quality gate passed"

# ----------------------------------------------------------------------------
# Frontend build (if present)
# ----------------------------------------------------------------------------

if [[ -d "$FRONTEND_DIR" ]] && [[ -f "$FRONTEND_DIR/package.json" ]]; then
  echo "==> Building frontend"
  (cd "$FRONTEND_DIR" && npm run build 2>&1) | verbose
fi

# ----------------------------------------------------------------------------
# CDK synth + deploy
# ----------------------------------------------------------------------------

cd "$CDK_DIR"

# Pass DOMAIN to CDK as a context value so the stack can read it via
# self.node.try_get_context('domain'). When DOMAIN is empty the stack should
# fall back to default API GW invoke URLs (no custom domain).
CDK_CONTEXT_FLAGS=()
[[ -n "$DOMAIN" ]] && CDK_CONTEXT_FLAGS+=(--context "domain=$DOMAIN")

echo "==> cdk synth"
cdk synth "${CDK_CONTEXT_FLAGS[@]}" --profile "$PROFILE" 2>&1 | verbose

echo "==> cdk diff"
cdk diff "${CDK_CONTEXT_FLAGS[@]}" --profile "$PROFILE" 2>&1 | verbose || true

if ! $ASSUME_YES; then
  if ! confirm "Proceed with cdk deploy?"; then
    echo "Aborted."
    exit 1
  fi
fi

echo "==> cdk deploy"
cdk deploy --all "${CDK_CONTEXT_FLAGS[@]}" \
  --profile "$PROFILE" --require-approval never 2>&1 | verbose

# ----------------------------------------------------------------------------
# Capture outputs
# ----------------------------------------------------------------------------

STACK_NAME=$(cdk list "${CDK_CONTEXT_FLAGS[@]}" --profile "$PROFILE" 2>/dev/null | head -1)
REGION="${AWS_REGION:-us-east-1}"

CF_URL=$(aws cloudformation describe-stacks \
  --stack-name "$STACK_NAME" --profile "$PROFILE" --region "$REGION" \
  --query 'Stacks[0].Outputs[?OutputKey==`CloudFrontUrl` || OutputKey==`DistributionDomainName`].OutputValue | [0]' \
  --output text 2>/dev/null || echo "")

API_URL=$(aws cloudformation describe-stacks \
  --stack-name "$STACK_NAME" --profile "$PROFILE" --region "$REGION" \
  --query 'Stacks[0].Outputs[?OutputKey==`ApiEndpoint` || OutputKey==`ApiUrl`].OutputValue | [0]' \
  --output text 2>/dev/null || echo "")

# ----------------------------------------------------------------------------
# Summary
# ----------------------------------------------------------------------------

note "Stack: $STACK_NAME — DEPLOYED"
note "Profile: $PROFILE"
note "Region: $REGION"
[[ -n "$DOMAIN" ]]                       && note "Domain: $DOMAIN"
[[ -n "$CF_URL" && "$CF_URL" != "None" ]] && note "CloudFront URL: https://$CF_URL"
[[ -n "$API_URL" && "$API_URL" != "None" ]] && note "API endpoint: $API_URL"

echo ""
echo "✓ Deploy complete"
echo "  Stack:       $STACK_NAME"
echo "  Profile:     $PROFILE"
echo "  Region:      $REGION"
[[ -n "$DOMAIN" ]]                       && echo "  Domain:      $DOMAIN"
[[ -n "$CF_URL" && "$CF_URL" != "None" ]] && echo "  CloudFront:  https://$CF_URL"
[[ -n "$API_URL" && "$API_URL" != "None" ]] && echo "  API:         $API_URL"
echo ""
echo "  Saved to .deploy-state.json under profile '$PROFILE' for next run."
